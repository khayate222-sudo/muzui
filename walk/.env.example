# Node.js 24+ / optional local overrides. Copy to .env; never commit .env.
PORT=3001
DATABASE_PATH=./data/walk.sqlite
APP_ORIGIN=http://localhost:3001
COOKIE_SECURE=false
# Optional: set a random secret with >=24 characters.
# When omitted, a random key is created in data/admin-key with mode 0600.
# ADMIN_KEY=
# CHROMIUM_PATH=/usr/bin/chromium

# Optional WebRTC ICE. Use off to disable the default public STUN server.
# WALK_STUN_URL=stun:stun.l.google.com:19302
# TURN is needed on networks where direct connections fail. Do not commit credentials.
# WALK_TURN_URL=turn:your-turn-host.example:3478
# WALK_TURN_USERNAME=
# WALK_TURN_CREDENTIAL=

# Native iOS/Android release: public HTTPS origin of the WALK backend (not a secret).
# Leave existing .env contents and user data intact. Never put keys in VITE_ variables.
# VITE_WALK_SERVER_URL=
